# ---- Required (from the Participant Portal) ----
SERVER_IP=192.168.1.100
BOT_ACCESS_TOKEN=paste_your_persistent_bearer_token_here
TEAM_USERNAME=alpha_lead

# ---- Optional ----
# Number of parallel Kafka consumers in group-<TEAM_USERNAME> (max 10)
NUM_CONSUMERS=4
# 0 = only trade in the live 'simulation' stage. 1 = also trade in the dev sandbox loop.
ALLOW_DEV_TRADING=0
LOG_LEVEL=INFO
